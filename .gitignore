.installed.cfg
*.egg
.env
.venv
env/
venv/
ENV/
.pytest_cache/

# Local configuration & credentials
secrets.yaml
*.local.py
*.local.json
*.local.yaml
*.local.yml
*.env*
!*.env.example

# Unity artifacts & build caches
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
